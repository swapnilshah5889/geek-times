  "slug": "dynamo",
  "pageTitle": "The cart that never disappears",
  "desk": "Distributed systems",
  "paper": {
    "title": "Dynamo: Amazon’s Highly Available Key-value Store",
    "authors": "DeCandia and colleagues",
    "year": 2007,
