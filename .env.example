# Copy this file to .env (gitignored) and fill in the values locally.
# This file holds names only. Never commit a value, and never print one in logs or chat.

# Browser variables. Vite bundles every VITE_ name into the public site, so only public-safe values go here.
# Supabase project URL the site reads from at runtime (decision 48).
VITE_SUPABASE_URL=
# Publishable (anon) key. Readers use it; row-level security limits what it can see.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Data source: "file" reads public/data (the default; empty also means file). "supabase" reads story documents and live library entries.
VITE_DATA_SOURCE=

# Server-side only. NEVER prefix with VITE_: a VITE_ name ends up in the browser bundle.
# Service-role (secret) key. Only the publish CLI (scripts/publish-to-supabase.ts) uses it.
SUPABASE_SERVICE_ROLE_KEY=
