# Copy this file to .env (gitignored) and fill in the values locally.
# This file holds names only. Never commit a value, and never print one in logs or chat.

# Browser variables. Vite bundles every VITE_ name into the public site, so only public-safe values go here.
# Supabase project URL the site reads from at runtime (decision 48).
VITE_SUPABASE_URL=
# Publishable (anon) key. Readers use it; row-level security limits what it can see.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. NEVER prefix with VITE_: a VITE_ name ends up in the browser bundle.
# Service-role (secret) key. Only the publish CLI (scripts/publish-to-supabase.ts) uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection URL for applying migrations (scripts/apply-migration.ts).
# From the Supabase dashboard: Project Settings → Database → Connection string → URI
# (transaction-mode pooler on port 6543 works; direct :5432 works too).
SUPABASE_DB_URL=

# Dev: show preview-status stories. Unset in production (hosted site) so only live stories render.
VITE_SHOW_PREVIEW=1

# Server-side only. Never prefix with VITE_: the conversion CLI uses only the provider selected below.
CONVERT_MODEL_PROVIDER=anthropic
# Optional stage overrides (CONVERT, FACT_CHECK, ILLUSTRATE) allow cheaper models for mechanical stages.
CONVERT_MODEL_PROVIDER_CONVERT=
CONVERT_MODEL_CONVERT=
CONVERT_MODEL_PROVIDER_FACT_CHECK=
CONVERT_MODEL_FACT_CHECK=
CONVERT_MODEL_PROVIDER_ILLUSTRATE=
CONVERT_MODEL_ILLUSTRATE=
# Anthropic provider settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenAI-compatible provider settings (supported by compatible inference services as well as OpenAI-style endpoints).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
