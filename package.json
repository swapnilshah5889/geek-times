{
  "name": "geeky-times",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "draw": "python3 tools/draw_attention.py",
    "prerender": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/prerender.ts",
    "check:prerender": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/check-prerender.ts",
    "check:hydration": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/check-hydration.ts",
    "convert": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/convert.ts",
    "publish:supabase": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/publish-to-supabase.ts",
    "status": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/status.ts",
    "approve": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/approve.ts",
    "apply:migration": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/apply-migration.ts",
    "seed:editorial": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env scripts/seed-editorial-from-library.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "pg": "^8.23.1",
    "puppeteer": "^25.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
